---
import { researchPath } from '../data/approach';
import type { Language } from '../data/profile';
import { ui } from '../data/ui';
import Icon from './Icon.astro';
interface Props { lang: Language; compact?: boolean }
const { lang, compact = false } = Astro.props;
const t = ui(lang);
---
<ol class:list={['research-path', { 'research-path-compact': compact }]} aria-label={t.approach} role="list">
  {researchPath.map(step => <li>
    <div class="path-marker" aria-hidden="true"><span>{step.number}</span><Icon name="arrow" size={16}/></div>
    <h3><a href={`/${lang}/research/#${step.section}`}>{step.title[lang]}</a></h3>
    <p>{compact ? step.short[lang] : step.description[lang]}</p>
  </li>)}
</ol>
