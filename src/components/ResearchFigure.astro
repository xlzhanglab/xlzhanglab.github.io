---
interface Props { kind?: 'compare' | 'surrogate' | 'embedding' | 'pareto'; label?: string }
const { kind = 'compare', label = 'Conceptual method illustration' } = Astro.props;
---
<svg class="research-figure" viewBox="0 0 220 138" role="img" aria-label={label}>
  <rect width="220" height="138" rx="5" fill="var(--figure-bg)"/>
  <g stroke="var(--figure-grid)" stroke-width=".6"><path d="M20 30H200M20 55H200M20 80H200M20 105H200M45 18V120M90 18V120M135 18V120M180 18V120"/></g>
  {kind === 'compare' && <>
    <g stroke="var(--figure-muted)" stroke-width="1.4" fill="none"><path d="M25 40 48 24 70 43 47 60zM25 40h45M48 24l-1 36M25 91l23-17 22 20-23 15zM25 91l45 3M48 74l-1 35"/><path d="M83 43h25M83 92h25M119 43l25 25-25 24M154 68h22"/></g>
    <g fill="var(--accent)"><circle cx="25" cy="40" r="4"/><circle cx="48" cy="24" r="4"/><circle cx="70" cy="43" r="4"/><circle cx="47" cy="60" r="4"/></g>
    <g fill="var(--figure-secondary)"><circle cx="25" cy="91" r="4"/><circle cx="48" cy="74" r="4"/><circle cx="70" cy="94" r="4"/><circle cx="47" cy="109" r="4"/></g>
    <rect x="107" y="32" width="21" height="23" rx="3" fill="var(--accent-soft)" stroke="var(--accent)"/><rect x="107" y="80" width="21" height="23" rx="3" fill="var(--figure-pale)" stroke="var(--figure-secondary)"/>
    <g fill="var(--accent)"><rect x="177" y="48" width="8" height="35" rx="1"/><rect x="189" y="62" width="8" height="21" rx="1" opacity=".6"/></g>
    <text x="110" y="128" text-anchor="middle">GRAPH → COMPARE → RANK</text>
  </>}
  {kind === 'surrogate' && <>
    <g stroke="var(--figure-muted)" stroke-width="1.4" fill="none"><path d="M22 62l24-23 24 23-24 23zM22 62h48M46 39v46M78 62h17M144 62h18"/></g>
    <g fill="var(--accent)"><circle cx="22" cy="62" r="4"/><circle cx="46" cy="39" r="4"/><circle cx="70" cy="62" r="4"/><circle cx="46" cy="85" r="4"/></g>
    <g stroke="var(--accent)" fill="var(--accent-soft)"><rect x="98" y="32" width="39" height="18" rx="3"/><rect x="98" y="55" width="39" height="18" rx="3"/><rect x="98" y="78" width="39" height="18" rx="3"/></g>
    <g fill="var(--figure-secondary)"><circle cx="176" cy="40" r="5"/><circle cx="194" cy="61" r="5"/><circle cx="176" cy="83" r="5"/></g><path d="M176 40l18 21-18 22" stroke="var(--figure-secondary)" fill="none"/>
    <text x="110" y="128" text-anchor="middle">GLOBAL TIERS · LOCAL RELATIONS</text>
  </>}
  {kind === 'embedding' && <>
    <path d="M29 23v79h166" fill="none" stroke="var(--figure-muted)" stroke-width="1.3"/>
    <ellipse cx="75" cy="73" rx="28" ry="19" fill="var(--accent-soft)"/><ellipse cx="151" cy="45" rx="31" ry="21" fill="var(--figure-pale)"/>
    <g fill="var(--accent)"><circle cx="63" cy="72" r="4"/><circle cx="73" cy="63" r="4"/><circle cx="84" cy="77" r="4"/><circle cx="71" cy="83" r="3"/><circle cx="89" cy="65" r="3"/></g>
    <g fill="var(--figure-secondary)"><circle cx="137" cy="43" r="4"/><circle cx="151" cy="54" r="4"/><circle cx="159" cy="39" r="4"/><circle cx="169" cy="50" r="3"/><circle cx="147" cy="33" r="3"/></g>
    <path d="M100 66l21-13M116 53h5v5" stroke="var(--figure-muted)" fill="none" stroke-width="1.4"/>
    <text x="110" y="128" text-anchor="middle">LEARN REPRESENTATIONS</text>
  </>}
  {kind === 'pareto' && <>
    <path d="M29 23v79h166" fill="none" stroke="var(--figure-muted)" stroke-width="1.3"/>
    <g fill="var(--figure-secondary)" opacity=".65"><circle cx="80" cy="37" r="3"/><circle cx="97" cy="53" r="3"/><circle cx="140" cy="40" r="3"/><circle cx="166" cy="69" r="3"/><circle cx="127" cy="57" r="3"/></g>
    <path d="M48 37c4 39 43 56 131 55" stroke="var(--accent)" stroke-width="1.5" fill="none"/>
    <g fill="var(--accent)"><circle cx="48" cy="37" r="4"/><circle cx="64" cy="66" r="4"/><circle cx="99" cy="84" r="4"/><circle cx="139" cy="91" r="4"/><circle cx="179" cy="92" r="4"/></g>
    <text x="110" y="128" text-anchor="middle">EXPLORING TRADE-OFFS</text>
  </>}
</svg>
